+
+// wchar_t do jogo (16 bits) -> ASCII para o rdpq_text. '#' alterna a cor (^00/^01); acentos viram a letra base.
+static int n64_text_ascii(const wchar_t* in, char* out, int cap, int* nlines)
+{
+    static const char kLatin1[] = "AAAAAAACEEEEIIIIDNOOOOOxOUUUUYTsaaaaaaaceeeeiiiidnooooo/ouuuuyty"; // U+00C0..U+00FF
+    int n = 0;
+    int style = 0;
+    int lines = 1;
+    for (const wchar_t* p = in; *p && n < cap - 8; ++p)
+    {
+        const unsigned c = static_cast<unsigned>(static_cast<uint16_t>(*p));
+        if (c == '\n')
+        {
+            out[n++] = '\n';
+            ++lines;
+        }
+        else if (c == '#')
+        {
+            style ^= 1;
+            out[n++] = '^';
+            out[n++] = '0';
+            out[n++] = style ? '1' : '0';
+        }
+        else if (c == '^' || c == '$')
+        {
+            out[n++] = static_cast<char>(c);
+            out[n++] = static_cast<char>(c);
+        }
+        else if (c >= 32 && c < 127)
+        {
+            out[n++] = static_cast<char>(c);
+        }
+        else if (c >= 0xC0 && c <= 0xFF)
+        {
+            out[n++] = kLatin1[c - 0xC0];
+        }
+        else if (c >= 127)
+        {
+            out[n++] = '?';
+        }
+    }
+    out[n] = 0;
+    *nlines = lines;
+    return n;
+}
+#endif
